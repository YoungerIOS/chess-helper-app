/* Dark Theme QSS (Custom from user colors) */

QMainWindow, QWidget {
    background-color: #212123;
    color: #d7cbb9;
}

QLabel {
    color: #d7cbb9;
}

QLabel#textDisplay {
    background-color: transparent;
    border: none;
    padding: 4px 12px;
    color: #E0E0E0;
}

/* 按钮通用样式 */
QPushButton {
    /* 默认样式，作为fallback或用于非primary按钮 */
    background-color: #2D4067;
    color: white;
    border: 1px solid #2D4067;
    border-radius: 8px;
    padding: 5px;
}

QPushButton#primary {
    border-radius: 8px;
    color: white;
    padding: 6px 18px;
    font-family: "Songti SC", "SimSun", "STSong", "Songti TC", serif;
    font-size: 13pt;
    font-weight: bold;

    /* 水平渐变：两边深(#2D4067)，中间浅(#4876AA) */
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #2D4067,
        stop:0.5 #4876AA,
        stop:1 #2D4067
    );

    /* 3D 立体边框 */
    border-style: solid;
    border-width: 1px;
    border-top-color: #5C8ABe;  /* 顶部高光 */
    border-left-color: #2D4067; 
    border-right-color: #2D4067;
    border-bottom-color: #0E1825; /* 底部阴影 */
    margin: 0px;
}

QPushButton#primary:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #415479,
        stop:0.5 #5C8ABe,
        stop:1 #415479
    );
    border-top-color: #7DA8D8;
    border-bottom-color: #0E1825;
}

QPushButton#primary:pressed {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #192C53,
        stop:0.5 #346296,
        stop:1 #192C53
    );
    /* 按下时反转边框或变暗 */
    border-top-color: #151e2f;
    border-bottom-color: #5C8ABe;
    padding: 7px 17px 5px 19px; /* 模拟按下位移 */
} 

QPushButton#secondary {
    background-color: #393C44;
    color: white;
    font-family: "Songti SC", "SimSun", "STSong", "Songti TC", serif;
    font-size: 12pt;
    font-weight: bold;
    
    border-style: solid;
    border-width: 1px;
    border-top-color: #505460;
    border-left-color: #393C44;
    border-right-color: #393C44;
    border-bottom-color: #1F2125;

    border-radius: 8px;
    padding: 0px 8px; /* 统一padding */
    margin: 0px;
}

QPushButton#secondary:hover {
    background-color: #4A4D55;
    border-top-color: #606470;
}

QPushButton#secondary:pressed {
    background-color: #292C34;
    border-top-color: #1F2125;
    border-bottom-color: #505460;
}

/* 参数 按钮（2字按钮，高精拟物底图切片 + 动态文字渲染） */
QPushButton#paramBtnSelect {
    border-image: url(app/images/ui/btn_param_normal.png) 0 0 0 0 stretch stretch;
    background: transparent;
    border: none;
    color: #C5C6CB;
    font-family: "Songti SC", "SimSun", "STSong", "Songti TC", serif;
    font-size: 11pt;
    font-weight: bold;
    padding: 0px 0px 7px 0px;
    margin: 0px;
}

QPushButton#paramBtnSelect:hover {
    border-image: url(app/images/ui/btn_param_hover.png) 0 0 0 0 stretch stretch;
    color: #FFFFFF;
}

QPushButton#paramBtnSelect:pressed {
    border-image: url(app/images/ui/btn_param_pressed.png) 0 0 0 0 stretch stretch;
    color: #9DA0A8;
    padding-top: 2px;
    padding-bottom: 5px;
}

/* 外观 / 其他 按钮（2字窄按钮，高精拟物底图切片 + 动态文字渲染） */
QPushButton#boardBtn, QPushButton#settingsBtn {
    border-image: url(app/images/ui/btn_param_normal.png) 0 0 0 0 stretch stretch;
    background: transparent;
    border: none;
    color: #C5C6CB;
    font-family: "Songti SC", "SimSun", "STSong", "Songti TC", serif;
    font-size: 12pt;
    font-weight: bold;
    padding: 0px 0px 7px 0px;
    margin: 0px;
}

QPushButton#boardBtn:hover, QPushButton#settingsBtn:hover {
    border-image: url(app/images/ui/btn_param_hover.png) 0 0 0 0 stretch stretch;
    color: #FFFFFF;
}

QPushButton#boardBtn:pressed, QPushButton#settingsBtn:pressed {
    border-image: url(app/images/ui/btn_param_pressed.png) 0 0 0 0 stretch stretch;
    color: #9DA0A8;
    padding-top: 2px;
    padding-bottom: 5px;
}

/* 参数调节胶囊步进器（三段式高精拟物底图切片 + 动态文字渲染） */
QPushButton#paramDecBtn {
    border-image: url(app/images/ui/stepper_minus_normal.png) 0 0 0 0 stretch stretch;
    background: transparent;
    border: none;
    color: #C5C6CB;
    font-size: 15pt;
    font-weight: bold;
    padding: 0px 0px 7px 0px;
    margin: 0px;
}

QPushButton#paramDecBtn:hover {
    border-image: url(app/images/ui/stepper_minus_hover.png) 0 0 0 0 stretch stretch;
    color: #FFFFFF;
}

QPushButton#paramDecBtn:pressed {
    border-image: url(app/images/ui/stepper_minus_pressed.png) 0 0 0 0 stretch stretch;
    color: #9DA0A8;
    padding-top: 2px;
    padding-bottom: 5px;
}

QLabel#paramLabel {
    border-image: url(app/images/ui/stepper_display.png) 0 0 0 0 stretch stretch;
    background: transparent;
    border: none;
    color: #D4D5DA;
    font-size: 12pt;
    font-weight: bold;
    padding: 0px 0px 7px 0px;
    margin: 0px;
}

QPushButton#paramIncBtn {
    border-image: url(app/images/ui/stepper_plus_normal.png) 0 0 0 0 stretch stretch;
    background: transparent;
    border: none;
    color: #C5C6CB;
    font-size: 15pt;
    font-weight: bold;
    padding: 0px 0px 7px 0px;
    margin: 0px;
}

QPushButton#paramIncBtn:hover {
    border-image: url(app/images/ui/stepper_plus_hover.png) 0 0 0 0 stretch stretch;
    color: #FFFFFF;
}

QPushButton#paramIncBtn:pressed {
    border-image: url(app/images/ui/stepper_plus_pressed.png) 0 0 0 0 stretch stretch;
    color: #9DA0A8;
    padding-top: 2px;
    padding-bottom: 5px;
}

/* 菜单样式 */
QMenu {
    background-color: #3A3C42;
    border: 1px solid #444;
    border-radius: 8px;
    padding: 2px;
}

QMenu::item {
    padding: 5px 20px 5px 20px; /* 上 右 下 左 */
    min-height: 20px;
    color: #d7cbb9;
}

QMenu::item:selected {
    background-color: #4876AA;
    color: white;
}

QMenu::item:checked {
    background-color: #2D4067;
    color: white;
}

/* 棋盘容器结构化样式 - Dark Theme */

/* 外壳层 (Board Shell) - 采用设计图原图切片高精度机甲金属外框 */
QFrame#boardShell {
    border-image: url(app/images/ui/board_frame.png) 26 32 30 32 stretch stretch;
    border-width: 18px 22px 21px 22px;
    background: transparent;
    padding: 0px;
    margin: 0px;
}

/* 内嵌层 (Board Inset) - 原图已烘焙完整内凹凹槽阴影，此处保持透明无侵入 */
QFrame#boardInset {
    background: transparent;
    border: none;
    padding: 0px;
    margin: 0px;
}

/* 画布层 (Board Canvas) - 仅显示内容 */
QLabel#boardImage {
    background-color: transparent; /* 背景透明，显示底层 */
    border: none; /* 无边框 */
    border-radius: 0px;
}

/* 退出按钮（高精拟物底图切片 + 动态文字渲染） */
QPushButton#exitBtn {
    border-image: url(app/images/ui/btn_exit_normal.png) 0 0 0 0 stretch stretch;
    background: transparent;
    border: none;
    color: #D88D88; /* 珊瑚粉红 */
    font-family: "Songti SC", "SimSun", "STSong", "Songti TC", serif;
    font-size: 12pt;
    font-weight: bold;
    padding: 0px 0px 7px 0px; /* 向上微调约2像素，视觉光学居中 */
    margin: 0px;
}

QPushButton#exitBtn:hover {
    border-image: url(app/images/ui/btn_exit_hover.png) 0 0 0 0 stretch stretch;
    color: #FFA49E; /* 悬浮时文字同步提亮 */
}

QPushButton#exitBtn:pressed {
    border-image: url(app/images/ui/btn_exit_pressed.png) 0 0 0 0 stretch stretch;
    color: #B86E6A; /* 按下时文字微暗 */
    padding-top: 2px;
    padding-bottom: 5px;
}
